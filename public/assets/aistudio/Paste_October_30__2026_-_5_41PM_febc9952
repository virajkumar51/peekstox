    content: ''; position: absolute; inset: 0; z-index: -1; border-radius: inherit; pointer-events: none;
    background-image: linear-gradient(115deg, transparent 38%, rgb(255 255 255 / 0.20) 49%, rgb(255 255 255 / 0.05) 53%, transparent 64%);
    background-size: 260% 100%; background-position: 140% 0;
    animation: glass-sweep 10s ease-in-out infinite;
  }
  .dock::after { animation-delay: 2.5s; }
  .light .ps-hero::after, .light .dock::after {
    background-image: linear-gradient(115deg, transparent 38%, rgb(255 255 255 / 0.65) 49%, rgb(255 255 255 / 0.15) 53%, transparent 64%);
  }
  @keyframes glass-sweep {
    0%, 55% { background-position: 140% 0; }
    100%    { background-position: -40% 0; }
  }

  /* 3. Cards catch light under the mouse or trackpad (JS sets --mx and --my). */
  @media (hover: hover) and (pointer: fine) {
    .ps-card:not(.ps-hero)::after {
      content: ''; position: absolute; inset: 0; z-index: -1; border-radius: inherit; pointer-events: none;
      opacity: 0; transition: opacity 0.25s ease;
      background: radial-gradient(240px circle at var(--mx, 50%) var(--my, 0%), rgb(255 255 255 / 0.14), transparent 65%);
    }
    .ps-card:not(.ps-hero):hover::after { opacity: 1; }
    .light .ps-card:not(.ps-hero)::after {
      background: radial-gradient(240px circle at var(--mx, 50%) var(--my, 0%), rgb(255 255 255 / 0.75), transparent 65%);
    }
  }

  /* Reduced motion / reduced transparency: static light, no movement. */
  @media (prefers-reduced-motion: reduce) {
    .app-root::before { animation: none; }
    .ps-hero::after, .dock::after { animation: none; opacity: 0; }
  }
  @media (prefers-reduced-transparency: reduce), (prefers-contrast: more) {
    .ps-hero::after, .dock::after, .ps-card::after { display: none; }
  }
}
