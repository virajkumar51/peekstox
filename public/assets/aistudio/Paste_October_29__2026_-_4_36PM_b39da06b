  const handleLogout = () => {
    setCurrentUser(GUEST_USER());
    setIsAuthOpen(false);
  };

  /* ---------- Render ---------- */
  // A foldable spanning two screens gives the content column only one screen's width.
  const contentLayout = layout.isSpanned ? 'medium' : layout.mode;

  return (
    <div
      className="app-root bg-[var(--bg-main)] text-[var(--text-primary)] transition-colors"
      data-layout={contentLayout}
      data-bottom-nav={layout.showBottomNav}
    >
      <a
        href="#main"
        onClick={(e) => {
          e.preventDefault(); // keep the hash router out of this
          mainRef.current?.focus();
        }}
        className="sr-only focus:not-sr-only focus:fixed focus:left-3 focus:top-3 focus:z-[100] focus:rounded-lg focus:bg-[var(--bg-card)] focus:px-4 focus:py-2 focus:text-sm focus:font-semibold"
      >
        Skip to main content
      </a>

      <Toast toast={activeToast} onDismiss={dismissToast} />

      <div className="app-shell">
        {layout.showSidebar && (
          <div className="app-nav-slot">
            <Sidebar
              activeView={activeView}
              onNavigate={navigate}
              unreadAlertsCount={unreadCount}
              onOpenAlerts={() => setIsAlertsOpen(true)}
              user={currentUser}
              onOpenAuth={() => setIsAuthOpen(true)}
            />
          </div>
        )}

        <div className="app-column">
          <Navbar
            user={currentUser}
            notifications={notifications}
            isDark={isDark}
            onToggleTheme={toggleTheme}
            onOpenSearch={() => setIsSearchOpen(true)}
            onOpenAlerts={() => setIsAlertsOpen(true)}
            onOpenAuth={() => setIsAuthOpen(true)}
            activeView={activeView}
            onNavigate={navigate}
            isLiveConnected={isLiveConnected}
            isSyncingLiveQuotes={isSyncingLiveQuotes}
            lastLiveSyncTime={lastLiveSyncTime}
            onRefreshQuotes={() => fetchLiveQuotes(true)}
            liveIndices={indices}
            featuredStocks={stocks}
            onSelectStock={openStock}
            showBrand={!layout.showSidebar}
            compact={layout.mode === 'compact'}
          />

          <main id="main" ref={mainRef} tabIndex={-1} className="app-main outline-none">
            <div className="app-content">
              {activeView === 'dashboard' && (
                <DashboardView indices={indices} stocks={stocks} news={MOCK_NEWS} watchlist={currentUser.watchlist} onSelectStock={openStock} onNavigate={navigate} onOpenAlerts={() => setIsAlertsOpen(true)} />
              )}
              {activeView === 'explorer' && (
                <StockExplorerView selectedTicker={selectedStockTicker} stocks={stocks} indices={indices} watchlist={currentUser.watchlist} onToggleWatchlist={handleToggleWatchlist} onSelectStock={setSelectedStockTicker} onOpenAlertForStock={openAlertsFor} onRefreshSingleQuote={fetchSingleLiveQuote} isSyncing={isSyncingLiveQuotes} />
              )}
              {activeView === 'compare' && <CompareView stocks={stocks} onSelectStock={openStock} />}
              {activeView === 'algo' && <AlgoLabView stocks={stocks} onSelectStock={openStock} />}
              {activeView === 'assistant' && (
                <AIResearchView stocks={stocks} activeStockTicker={selectedStockTicker} onSelectStock={setSelectedStockTicker} />
              )}
              {activeView === 'watchlist' && (
                <WatchlistView watchlist={currentUser.watchlist} stocks={stocks} onSelectStock={openStock} onRemoveFromWatchlist={handleToggleWatchlist} onOpenSearch={() => setIsSearchOpen(true)} onOpenAlertForStock={openAlertsFor} />
              )}
              {activeView === 'overview' && <MarketOverviewView indices={indices} stocks={stocks} onSelectStock={handleSelectStock} />}
              {activeView === 'news' && <NewsCenterView news={MOCK_NEWS} stocks={stocks} onSelectStock={openStock} />}
              {(activeView === 'settings' || activeView === 'about') && (
                <SettingsView user={currentUser} isDark={isDark} initialTab={activeView === 'about' ? 'about' : 'preferences'} onToggleTheme={toggleTheme} onUpdateProfile={handleUpdateProfile} onOpenAuth={() => setIsAuthOpen(true)} onLogout={handleLogout} onNavigate={navigate} />
              )}
            </div>
          </main>
        </div>
      </div>

      {layout.showBottomNav && (
        <BottomNav activeView={activeView} onNavigate={navigate} onOpenAlerts={() => setIsAlertsOpen(true)} unreadAlertsCount={unreadCount} />
      )}

      <GlobalSearchModal isOpen={isSearchOpen} onClose={() => setIsSearchOpen(false)} stocks={stocks} onSelectStock={openStock} />

      <AlertsCenterModal isOpen={isAlertsOpen} onClose={() => setIsAlertsOpen(false)} stocks={stocks} alerts={currentUser.alerts} notifications={notifications} onCreateAlert={handleCreateAlert} onDeleteAlert={handleDeleteAlert} onToggleAlert={handleToggleAlert} onMarkAllNotificationsRead={() => setNotifications((p) => p.map((n) => ({ ...n, isRead: true })))} onClearNotifications={() => setNotifications([])} onSimulateAlertTrigger={handleSimulateAlertTrigger} />

      <AuthModal isOpen={isAuthOpen} onClose={() => setIsAuthOpen(false)} currentUser={currentUser} onLogin={handleLogin} onRegister={handleRegister} onUpdateProfile={handleUpdateProfile} onLogout={handleLogout} />
    </div>
  );
}
